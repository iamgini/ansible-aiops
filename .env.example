# Environment variables for MCP Integration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# AAP MCP Server Configuration
AAP_MCP_SERVER_URL=https://aap.example.com:8448

# AAP Authentication
# Obtain token from: AAP UI → Users → [Your User] → Tokens
AAP_BEARER_TOKEN=your_aap_bearer_token_here

# Optional: AAP Controller Details (if not using MCP)
CONTROLLER_HOST=https://controller.example.com
CONTROLLER_USERNAME=admin
CONTROLLER_PASSWORD=
CONTROLLER_VERIFY_SSL=false

# Optional: EDA Controller Details
EDA_CONTROLLER_HOST=https://eda.example.com
EDA_CONTROLLER_TOKEN=

# Red Hat Automation Code Assistant (AAP 2.6+ Lightspeed)
# For AI-powered playbook generation
LIGHTSPEED_URL=http://lightspeed-coding-assistant.internal:8000/api/v0/ai/generations/
LIGHTSPEED_TOKEN=${AAP_BEARER_TOKEN}

# Git Configuration (for Code Assistant playbook generation)
GIT_TOKEN=your_github_personal_access_token
GIT_USERNAME=your_github_username
GIT_EMAIL=your_email@example.com

# Optional: MCP Server Configuration (if running your own)
MCP_SERVER_PORT=3000
ALLOW_WRITE_OPERATIONS=false
