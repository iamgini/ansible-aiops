---
# Auto-generated by aiops_cac_manager role
# Workflow Template: Project Sync → Approval → Run Remediation
controller_workflows:
  - name: "{{ aap_wf_prefix }}-{{ event_type }}-{{ event_host | regex_replace('\\.', '-') }}"
    description: "AI-generated remediation workflow for {{ event_type }} on {{ event_host }}"
    organization: "{{ aap_organization }}"
    allow_simultaneous: false
    ask_variables_on_launch: true
    extra_vars:
      event_type: "{{ event_type }}"
      event_host: "{{ event_host }}"
      event_severity: "{{ event_severity }}"
    simplified_workflow_nodes:
      - identifier: sync-project
        unified_job_template: "{{ aap_project }}"
        success_nodes:
          - approve-remediation
        failure_nodes:
          - notify-failure
        all_parents_must_converge: false

      - identifier: approve-remediation
        approval_node:
          name: "Approve: {{ event_type }} remediation on {{ event_host }}"
          description: "Review AI-generated playbook ({{ git_playbook_dir }}/{{ ai_playbook_filename }}) before execution"
          timeout: {{ aap_approval_timeout }}
        success_nodes:
          - run-remediation
        failure_nodes:
          - notify-failure

      - identifier: run-remediation
        unified_job_template: "{{ aap_jt_prefix }}-{{ event_type }}-{{ event_host | regex_replace('\\.', '-') }}"
        success_nodes: []
        failure_nodes:
          - notify-failure
        all_parents_must_converge: false

      - identifier: notify-failure
        approval_node:
          name: "FAILED: {{ event_type }} remediation on {{ event_host }}"
          description: "Workflow failed - review logs and take manual action"
          timeout: 0
    labels:
{% for label in aap_default_labels %}
      - "{{ label }}"
{% endfor %}
      - approval-required
      - "{{ event_type }}"
