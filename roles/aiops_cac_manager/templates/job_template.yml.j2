---
# Auto-generated by aiops_cac_manager role
# Job Template for AI-generated remediation playbook
controller_templates:
  - name: "{{ aap_jt_prefix }}-{{ event_type }}-{{ event_host | regex_replace('\\.', '-') }}"
    description: "AI-generated remediation for {{ event_type }} on {{ event_host }} [{{ ai_backend_used | default('unknown') }}]"
    job_type: run
    inventory: "{{ aap_inventory }}"
    project: "{{ aap_project }}"
    playbook: "{{ git_playbook_dir }}/{{ ai_playbook_filename }}"
    credentials:
      - "{{ aap_machine_credential }}"
    verbosity: 0
    ask_limit_on_launch: true
    ask_variables_on_launch: true
    extra_vars:
      event_type: "{{ event_type }}"
      event_host: "{{ event_host }}"
      event_severity: "{{ event_severity }}"
{% if event_description is defined %}
      event_description: "{{ event_description }}"
{% endif %}
{% if event_service is defined and event_service | length > 0 %}
      event_service: "{{ event_service }}"
{% endif %}
    labels:
{% for label in aap_default_labels %}
      - "{{ label }}"
{% endfor %}
      - "{{ event_type }}"
{% if event_severity is defined %}
      - "severity-{{ event_severity }}"
{% endif %}
